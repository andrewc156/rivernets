% Gemini theme
% https://github.com/anishathalye/gemini
%
% Unofficial Kennesaw State University color theme.

% ====================
% Definitions
% ====================

\definecolor{ksugold}{RGB}{255, 196, 44}
\definecolor{ksublack}{RGB}{0, 0, 0}
\definecolor{ksugray}{RGB}{176, 179, 178}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=ksublack,bg=white}
\setbeamercolor{palette secondary}{fg=ksublack,bg=white}
\setbeamercolor{palette tertiary}{bg=ksublack,fg=white}
\setbeamercolor{palette quaternary}{fg=ksublack,bg=white}
\setbeamercolor{structure}{fg=ksublack}

% Headline
\setbeamercolor{headline}{fg=ksublack,bg=ksugold}
\setbeamercolor{headline rule}{bg=ksublack}

% Block
\setbeamercolor{block title}{fg=ksublack,bg=white}
\setbeamercolor{block separator}{bg=ksugold}
\setbeamercolor{block body}{fg=ksublack,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=ksublack,bg=ksugold}
\setbeamercolor{block alerted separator}{bg=ksublack}
\setbeamercolor{block alerted body}{fg=ksublack,bg=ksugold}

% Example Block
\setbeamercolor{block example title}{fg=ksublack,bg=ksugray}
\setbeamercolor{block example separator}{bg=ksublack}
\setbeamercolor{block example body}{fg=ksublack,bg=ksugray}

% Heading
\setbeamercolor{heading}{fg=ksublack}

% Itemize
\setbeamercolor{item}{fg=ksugold}

% Bibliography
\setbeamercolor{bibliography item}{fg=ksublack}
\setbeamercolor{bibliography entry author}{fg=ksublack}
\setbeamercolor{bibliography entry title}{fg=ksublack}
\setbeamercolor{bibliography entry location}{fg=ksublack}
\setbeamercolor{bibliography entry note}{fg=ksublack}
\setbeamertemplate{bibliography entry article}{}
\setbeamertemplate{bibliography entry title}{}
\setbeamertemplate{bibliography entry location}{}
\setbeamertemplate{bibliography entry note}{}